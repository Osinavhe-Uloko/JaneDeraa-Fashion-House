# Supabase project settings — find these in Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — server-side ONLY, never expose to the browser.
# Used so the API can read/write tables regardless of Row Level Security policies.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds product/editorial imagery (created by scripts/seed.js if missing)
SUPABASE_STORAGE_BUCKET=product-images

# Unsplash API access key — used only by scripts/seed.js to fetch licensed
# stock photography for products/journal covers that don't have real
# photography yet (see scripts/product-photos/). Free key, no cost:
# 1. https://unsplash.com/developers -> "Register as a developer" -> "New Application"
# 2. Accept the API terms, name the app anything (e.g. "JaneDeraa seed")
# 3. Copy the "Access Key" from the app's page into this line
# If left blank, the seed script falls back to a generated placeholder swatch.
UNSPLASH_ACCESS_KEY=

# Port the Express API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your Next.js dev/prod URLs)
CORS_ORIGIN=http://localhost:3000
