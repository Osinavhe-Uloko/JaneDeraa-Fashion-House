# Base URL of the Express API (server/ folder). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Supabase project settings — used client-side for Auth (sign in / register / account).
# Find these in Supabase dashboard → Project Settings → API. The anon key is safe
# to expose in the browser; it only has the access granted by your RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
